    <ApplicationTitle>FastChartsScene</ApplicationTitle><ApplicationId>org.fastchartsscene.explorer</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion><ApplicationVersion>1</ApplicationVersion>
    <UnoFeatures>SkiaRenderer;GLCanvas;</UnoFeatures>
    <WasmShellWebAppBasePath>/FastChartsScene/</WasmShellWebAppBasePath><WasmShellEnablePWA>false</WasmShellEnablePWA>
    <IsPackable>false</IsPackable>
