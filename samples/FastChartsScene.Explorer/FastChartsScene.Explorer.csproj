  <ItemGroup>
    <ProjectReference Include="../../src/FastChartsScene.Controls.Uno/FastChartsScene.Controls.Uno.csproj" />
    <ProjectReference Include="../../src/FastChartsScene.Examples/FastChartsScene.Examples.csproj" />
    <ProjectReference Include="../../src/FastChartsScene.Serialization/FastChartsScene.Serialization.csproj" />
  </ItemGroup>
</Project>
