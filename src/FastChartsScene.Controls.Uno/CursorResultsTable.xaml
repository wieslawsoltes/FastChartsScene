<UserControl x:Class="FastChartsScene.Controls.Uno.CursorResultsTable"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:FastChartsScene.Controls.Uno" RequestedTheme="Light">
 <UserControl.Resources>
  <DataTemplate x:Key="ResultTemplate" x:DataType="local:CursorResultRow">
   <Grid Height="28" Padding="6,0" ColumnSpacing="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
     <Border Background="{x:Bind Swatch,Mode=OneWay}" Width="8" Height="8"/>
     <TextBlock Text="{x:Bind Title,Mode=OneWay}" FontSize="11" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <TextBlock Grid.Column="1" Text="{x:Bind IndexText,Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind IndexText,Mode=OneWay}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>
    <TextBlock Grid.Column="2" Text="{x:Bind XText,Mode=OneWay}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>
    <TextBlock Grid.Column="3" Text="{x:Bind YText,Mode=OneWay}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>
    <TextBlock Grid.Column="4" Text="{x:Bind FieldText,Mode=OneWay}" FontSize="11" VerticalAlignment="Center"/>
   </Grid>
  </DataTemplate>
 </UserControl.Resources>
 <Grid Background="#F4F4F4" BorderBrush="#AFAFAF" BorderThickness="0,1,0,0">
  <Grid.RowDefinitions><RowDefinition x:Name="ResizeRow" Height="0"/><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
  <Thumb x:Name="ResizeGrip" Height="6" Visibility="Collapsed" Background="#C4C4C4" IsTabStop="True" UseSystemFocusVisuals="True"
   AutomationProperties.Name="Resize cursor table" AutomationProperties.HelpText="Drag to resize. Up or Down adjusts 12 pixels; Page Up or Page Down adjusts 48. Home or double-click resets."
   DragDelta="ResizeDragged" DragStarted="ResizeStarted" KeyDown="ResizeKeyDown" DoubleTapped="ResizeDoubleTapped">
   <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="{TemplateBinding Background}"><Border Height="1" Width="40" Background="#777777" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></ControlTemplate></Thumb.Template>
  </Thumb>
  <Grid Grid.Row="1" Padding="7,2" ColumnSpacing="8" Background="#E5E5E5">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="Status" Text="Cursor values · move over a chart" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   <ComboBox x:Name="TrackingModeChoice" Grid.Column="1" Width="124" MinHeight="24" Padding="5,0" FontSize="11" Visibility="Collapsed"
    AutomationProperties.Name="Cursor tracking mode" AutomationProperties.HelpText="Nearest X shows original samples. Interpolated calculates linear and stepped crossings; Calc Y and endpoint indices identify calculated rows. Financial, scatter-only and cubic values stay original. Changing mode clears Hold."
    SelectionChanged="TrackingModeSelected">
    <ComboBoxItem Content="Nearest X"/><ComboBoxItem Content="Interpolated"/>
   </ComboBox>
   <ToggleButton x:Name="Hold" Grid.Column="2" Content="Hold" AutomationProperties.Name="Hold cursor values" MinHeight="24" Padding="8,1" FontSize="11" Checked="HoldChanged" Unchecked="HoldChanged"/>
   <Button Grid.Column="3" Content="CSV" AutomationProperties.Name="Export cursor values" MinHeight="24" Padding="8,1" FontSize="11" Click="ExportClicked"/>
  </Grid>
  <ScrollViewer Grid.Row="2" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
   <Grid MinWidth="660">
    <Grid.RowDefinitions><RowDefinition Height="23"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Padding="6,0" ColumnSpacing="8" Background="#EEEEEE">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
     <TextBlock Text="Series" FontSize="11" FontWeight="SemiBold"/>
     <TextBlock Grid.Column="1" Text="Index" FontSize="11" TextAlignment="Right"/>
     <TextBlock x:Name="ResultXHeader" Grid.Column="2" Text="Original X" FontSize="11" TextAlignment="Right"/>
     <TextBlock x:Name="ResultValueHeader" Grid.Column="3" Text="Original value" FontSize="11" TextAlignment="Right"/>
     <TextBlock Grid.Column="4" Text="Field" FontSize="11"/>
    </Grid>
    <ListView x:Name="Results" Grid.Row="1" ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource ResultTemplate}" SelectionMode="Single" SelectionChanged="SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Same-pane cursor results">
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="MinHeight" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
     <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical"/></ItemsPanelTemplate></ListView.ItemsPanel>
    </ListView>
   </Grid>
  </ScrollViewer>
  <TextBox x:Name="Details" Grid.Row="3" FontSize="10" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0,1,0,0" Padding="6,3" AutomationProperties.Name="Original cursor value details" AutomationProperties.HelpText="Full-precision result and original sample or interpolation endpoint values."/>
 </Grid>
</UserControl>
